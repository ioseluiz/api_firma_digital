{
  "info": {
    "name": "INI Firma — API de firma",
    "description": "Pruebas manuales del servicio de firma (api-ini-firma).\n\nAntes de usar: importar también el entorno generado con `python postman/generar_entorno.py --pdf <tu.pdf> --imagen-id <tu.png>` y seleccionarlo arriba a la derecha.\n\nVariables del entorno: base_url, function_key (vacío en local), imagen_id, codigo, ancla_texto, pdf_base64.\n\nLas peticiones con Accept: application/pdf devuelven el archivo: usar 'Send and Download' (flecha junto a Send) para guardarlo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-functions-key", "type": "string" },
      { "key": "value", "value": "{{function_key}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: 'postman-' + Date.now() });",
          "if (!pm.environment.get('pdf_base64')) { console.warn('pdf_base64 vacío: genera el entorno con postman/generar_entorno.py'); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/v1/salud", "host": ["{{base_url}}"], "path": ["api", "v1", "salud"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('ok = true', () => pm.expect(d.ok).to.be.true);",
              "pm.test('imagen por defecto accesible', () => pm.expect(d.imagen_por_defecto_ok).to.be.true);",
              "console.log('versión', d.version, '| origen', d.origen_imagenes, '| imagen', d.imagen_por_defecto);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Firmar — solo imagen, última página (JSON)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solicitud_id\": 1,\n  \"codigo\": \"{{codigo}}\",\n  \"pdf_base64\": \"{{pdf_base64}}\",\n  \"firmante\": { \"imagen_id\": \"{{imagen_id}}\" },\n  \"fecha_firma\": \"{{fecha_firma}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/v1/firmar", "host": ["{{base_url}}"], "path": ["api", "v1", "firmar"] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// fecha_firma: hora local de Panamá (UTC-5) sin zona, como la manda el flujo",
              "const d = new Date(Date.now() - 5 * 3600 * 1000);",
              "pm.variables.set('fecha_firma', d.toISOString().slice(0, 19));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('ok = true', () => pm.expect(d.ok).to.be.true);",
              "pm.test('devuelve PDF firmado', () => pm.expect(d.pdf_firmado_base64).to.be.a('string').and.not.empty);",
              "pm.test('sha256 de 64 hex', () => pm.expect(d.sha256).to.match(/^[0-9a-f]{64}$/));",
              "pm.test('código de verificación de 12', () => pm.expect(d.codigo_verificacion).to.have.lengthOf(12));",
              "pm.environment.set('sha256', d.sha256);",
              "pm.environment.set('codigo_verificacion', d.codigo_verificacion);",
              "console.log('páginas', d.paginas, '| firmada', d.pagina_firmada, '| ancla', d.ancla_encontrada, '| ms', d.duracion_ms, '| sha256', d.sha256);",
              "pm.visualizer.set('<p style=\"font-family:sans-serif\">Firmado: página <b>{{pagina_firmada}}</b> de {{paginas}} · {{duracion_ms}} ms · SHA-256 <code>{{sha256}}</code><br>Para ver el PDF usa la petición 03 con <i>Send and Download</i>.</p>', d);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Firmar — con ancla, descarga el PDF (Send and Download)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/pdf" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solicitud_id\": 2,\n  \"codigo\": \"{{codigo}}\",\n  \"pdf_base64\": \"{{pdf_base64}}\",\n  \"firmante\": { \"imagen_id\": \"{{imagen_id}}\" },\n  \"fecha_firma\": \"{{fecha_firma}}\",\n  \"posicion\": {\n    \"pagina\": 0,\n    \"ancla_texto\": \"{{ancla_texto}}\",\n    \"ancla_alineacion\": \"centro\",\n    \"ancho_mm\": 35,\n    \"si_no_hay_ancla\": \"posicion_fija\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/v1/firmar", "host": ["{{base_url}}"], "path": ["api", "v1", "firmar"] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = new Date(Date.now() - 5 * 3600 * 1000);",
              "pm.variables.set('fecha_firma', d.toISOString().slice(0, 19));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('es un PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));",
              "pm.test('ancla encontrada', () => pm.expect(pm.response.headers.get('X-Ancla-Encontrada')).to.eql('true'));",
              "console.log('página firmada', pm.response.headers.get('X-Pagina-Firmada'), '| sha256', pm.response.headers.get('X-Sha256'), '| verif', pm.response.headers.get('X-Codigo-Verificacion'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Firmar — posición fija en mm, descarga el PDF",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/pdf" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solicitud_id\": 3,\n  \"codigo\": \"{{codigo}}\",\n  \"pdf_base64\": \"{{pdf_base64}}\",\n  \"firmante\": { \"imagen_id\": \"{{imagen_id}}\" },\n  \"fecha_firma\": \"{{fecha_firma}}\",\n  \"posicion\": { \"pagina\": 0, \"x_mm\": 120, \"y_mm\": 40, \"ancho_mm\": 50 }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/v1/firmar", "host": ["{{base_url}}"], "path": ["api", "v1", "firmar"] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": { "type": "text/javascript", "exec": ["pm.variables.set('fecha_firma', new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19));"] }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('es un PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Firmar — con sello de texto (opcional), descarga el PDF",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/pdf" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solicitud_id\": 4,\n  \"codigo\": \"{{codigo}}\",\n  \"pdf_base64\": \"{{pdf_base64}}\",\n  \"firmante\": {\n    \"nombre\": \"Ing. José Luis Muñoz\",\n    \"cargo\": \"Gerente, División de Ingeniería\",\n    \"imagen_id\": \"{{imagen_id}}\"\n  },\n  \"fecha_firma\": \"{{fecha_firma}}\",\n  \"posicion\": { \"pagina\": 0, \"ancla_texto\": \"{{ancla_texto}}\", \"ancho_mm\": 35 },\n  \"sello\": { \"texto\": true, \"codigo_verificacion\": true }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/v1/firmar", "host": ["{{base_url}}"], "path": ["api", "v1", "firmar"] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": { "type": "text/javascript", "exec": ["pm.variables.set('fecha_firma', new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19));"] }
        },
        {
          "listen": "test",
          "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] }
        }
      ]
    },
    {
      "name": "06 Error — imagen inexistente (404)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solicitud_id\": 5,\n  \"codigo\": \"{{codigo}}\",\n  \"pdf_base64\": \"{{pdf_base64}}\",\n  \"firmante\": { \"imagen_id\": \"no-existe.png\" },\n  \"fecha_firma\": \"2026-11-19T10:00:00\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/v1/firmar", "host": ["{{base_url}}"], "path": ["api", "v1", "firmar"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('error = imagen_no_encontrada', () => pm.expect(pm.response.json().error).to.eql('imagen_no_encontrada'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Error — página fuera de rango (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solicitud_id\": 6,\n  \"codigo\": \"{{codigo}}\",\n  \"pdf_base64\": \"{{pdf_base64}}\",\n  \"firmante\": { \"imagen_id\": \"{{imagen_id}}\" },\n  \"fecha_firma\": \"2026-11-19T10:00:00\",\n  \"posicion\": { \"pagina\": 999 }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/v1/firmar", "host": ["{{base_url}}"], "path": ["api", "v1", "firmar"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('error = pagina_fuera_de_rango', () => pm.expect(pm.response.json().error).to.eql('pagina_fuera_de_rango'));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Error — ancla ausente en modo error (422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"solicitud_id\": 7,\n  \"codigo\": \"{{codigo}}\",\n  \"pdf_base64\": \"{{pdf_base64}}\",\n  \"firmante\": { \"imagen_id\": \"{{imagen_id}}\" },\n  \"fecha_firma\": \"2026-11-19T10:00:00\",\n  \"posicion\": { \"ancla_texto\": \"texto que no existe en el documento\", \"si_no_hay_ancla\": \"error\" }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/v1/firmar", "host": ["{{base_url}}"], "path": ["api", "v1", "firmar"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
              "pm.test('error = ancla_no_encontrada', () => pm.expect(pm.response.json().error).to.eql('ancla_no_encontrada'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Error — campos faltantes (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"codigo\": \"X\" }", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/api/v1/firmar", "host": ["{{base_url}}"], "path": ["api", "v1", "firmar"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "const d = pm.response.json();",
              "pm.test('error = peticion_invalida', () => pm.expect(d.error).to.eql('peticion_invalida'));",
              "pm.test('el mensaje nombra los campos', () => pm.expect(d.mensaje).to.include('pdf_base64'));"
            ]
          }
        }
      ]
    }
  ]
}
