                  },
                  "runAfter": {
                    "Propiedades_original": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Motivo_invalido": {
                    "type": "Compose",
                    "inputs": "@concat(if(equals(length(body('Filtrar_memo')),1),'',concat('Debe haber exactamente un archivo MEMO_....pdf (hay ', length(body('Filtrar_memo')), '). ')), if(equals(length(body('Filtrar_no_pdf')),0),'','Todos los archivos deben ser PDF. '), if(equals(length(body('Adjuntos')),add(length(body('Filtrar_memo')),length(body('Filtrar_anexos')))),'','Cada archivo debe empezar con MEMO_ o ANEXO_.'))",
                    "runAfter": {}
                  },
                  "Devolver_a_borrador": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "parameters": {
                        "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
                        "table": "767347d5-3d27-4b12-8360-f114d5c51002",
                        "id": "@triggerOutputs()?['body/ID']",
                        "item/Title": "@triggerOutputs()?['body/Title']",
                        "item/Accion": "Revisar",
                        "item/Error_Detalle": "@outputs('Motivo_invalido')"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {
                      "Motivo_invalido": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Bitacora_invalido": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PostItem"
                      },
                      "parameters": {
                        "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
                        "table": "05d9b67a-a005-4826-ad13-67a622f834aa",
                        "item/Title": "Envío no válido",
                        "item/Solicitud_ID_Num": "@triggerOutputs()?['body/ID']",
                        "item/Codigo": "@coalesce(triggerOutputs()?['body/Codigo'],'')",
                        "item/Evento": "Envío no válido",
                        "item/Actor_Email": "@toLower(coalesce(triggerOutputs()?['body/Editor/Email'],''))",
                        "item/Detalle": "@outputs('Motivo_invalido')",
                        "item/Fecha": "@utcNow()"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {
                      "Devolver_a_borrador": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Correo_invalido": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2"
                      },
                      "parameters": {
                        "emailMessage/To": "@{if(equals(parameters('ini_FIRMA_ModoPrueba (ini_FIRMA_ModoPrueba)'),'SI'), parameters('ini_FIRMA_CorreoSoporte (ini_FIRMA_CorreoSoporte)'), coalesce(triggerOutputs()?['body/Solicitante_Email'], triggerOutputs()?['body/Solicitante/Email'], triggerOutputs()?['body/Author/Email']))}",
                        "emailMessage/Subject": "@{if(equals(parameters('ini_FIRMA_ModoPrueba (ini_FIRMA_ModoPrueba)'),'SI'),'[PRUEBA] ','')}No se pudo enviar a firma: @{triggerOutputs()?['body/Title']}",
                        "emailMessage/Body": "<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#1f2937;max-width:640px\">\n<div style=\"background:#00539B;color:#fff;padding:14px 18px;font-size:16px;font-weight:600\">La solicitud no se pudo enviar</div>\n<div style=\"padding:16px 18px;border:1px solid #d6dde6;border-top:0\">\n<p style=\"margin:0 0 12px\">Revise los archivos adjuntos y vuelva a enviarla desde la app.</p>\n<table style=\"border-collapse:collapse;width:100%\"><tr><td style=\"padding:6px 8px;background:#f3f6f9;width:170px;font-weight:600\">Título</td><td style=\"padding:6px 8px\">@{triggerOutputs()?['body/Title']}</td></tr><tr><td style=\"padding:6px 8px;background:#f3f6f9;width:170px;font-weight:600\">Motivo</td><td style=\"padding:6px 8px\">@{outputs('Motivo_invalido')}</td></tr></table>\n\n<p style=\"margin:16px 0 0;color:#6b7280;font-size:12px\">Firma de Documentos · INI. Correo automático, no responder.</p>\n</div></div>",
                        "emailMessage/Importance": "Normal"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {
                      "Bitacora_invalido": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
