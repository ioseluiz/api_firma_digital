{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ini_firma_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ini_firma_outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)": {
          "defaultValue": "SIN_CONFIGURAR",
          "type": "String",
          "metadata": {
            "schemaName": "ini_FIRMA_SitioUrl"
          }
        },
        "ini_FIRMA_BibliotecaId (ini_FIRMA_BibliotecaId)": {
          "defaultValue": "SIN_CONFIGURAR",
          "type": "String",
          "metadata": {
            "schemaName": "ini_FIRMA_BibliotecaId"
          }
        },
        "ini_FIRMA_ModoPrueba (ini_FIRMA_ModoPrueba)": {
          "defaultValue": "SIN_CONFIGURAR",
          "type": "String",
          "metadata": {
            "schemaName": "ini_FIRMA_ModoPrueba"
          }
        },
        "ini_FIRMA_CorreoSoporte (ini_FIRMA_CorreoSoporte)": {
          "defaultValue": "SIN_CONFIGURAR",
          "type": "String",
          "metadata": {
            "schemaName": "ini_FIRMA_CorreoSoporte"
          }
        }
      },
      "triggers": {
        "Al_crear_o_modificar_solicitud": {
          "type": "OpenApiConnection",
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "conditions": [
            {
              "expression": "@and(equals(triggerOutputs()?['body/Accion'],'Cancelar'), empty(triggerOutputs()?['body/Accion_Fecha']), or(equals(triggerOutputs()?['body/Estado/Value'],'Borrador'), equals(triggerOutputs()?['body/Estado/Value'],'Pendiente de firma')))"
            }
          ],
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems"
            },
            "parameters": {
              "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
              "table": "767347d5-3d27-4b12-8360-f114d5c51002"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Marcar_accion_tomada": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
              "table": "767347d5-3d27-4b12-8360-f114d5c51002",
              "id": "@triggerOutputs()?['body/ID']",
              "item/Title": "@triggerOutputs()?['body/Title']",
              "item/Accion_Fecha": "@utcNow()"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Leer_roles": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
              "table": "41a2b1f3-f830-4b76-9d11-a7d466020d5a",
              "$filter": "Activo eq 1",
              "$orderby": "Title",
              "$top": 50
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Marcar_accion_tomada": [
              "Succeeded"
            ]
          }
        },
        "Filtrar_Gerente": {
          "type": "Query",
          "inputs": {
            "from": "@body('Leer_roles')?['value']",
            "where": "@equals(item()?['Title'],'Gerente')"
          },
          "runAfter": {
            "Leer_roles": [
              "Succeeded"
            ]
          }
        },
        "Try": {
          "type": "Scope",
          "actions": {
            "Secretaria_o_admin": {
              "type": "Query",
              "inputs": {
                "from": "@body('Leer_roles')?['value']",
                "where": "@and(or(equals(item()?['Title'],'Secretaria'),equals(item()?['Title'],'Administrador')), equals(toLower(coalesce(item()?['Email'],'')), toLower(coalesce(triggerOutputs()?['body/Editor/Email'],''))))"
              },
              "runAfter": {}
            },
            "Es_autorizado": {
              "type": "Compose",
              "inputs": "@or(equals(toLower(coalesce(triggerOutputs()?['body/Editor/Email'],'')), toLower(coalesce(triggerOutputs()?['body/Solicitante/Email'],''))), equals(toLower(coalesce(triggerOutputs()?['body/Editor/Email'],'')), toLower(coalesce(triggerOutputs()?['body/Solicitante_Email'],''))), equals(toLower(coalesce(triggerOutputs()?['body/Editor/Email'],'')), toLower(coalesce(triggerOutputs()?['body/Registrado_Por_Email'],''))), equals(toLower(coalesce(triggerOutputs()?['body/Editor/Email'],'')), toLower(coalesce(triggerOutputs()?['body/Author/Email'],''))), greater(length(body('Secretaria_o_admin')),0))",
              "runAfter": {
                "Secretaria_o_admin": [
                  "Succeeded"
                ]
              }
            },
            "Validar_cancelacion": {
              "type": "If",
              "expression": {
                "equals": [
                  "@outputs('Es_autorizado')",
                  true
                ]
              },
              "actions": {
                "Pasar_a_cancelado": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
                      "table": "767347d5-3d27-4b12-8360-f114d5c51002",
                      "id": "@triggerOutputs()?['body/ID']",
                      "item/Title": "@triggerOutputs()?['body/Title']",
                      "item/Estado/Value": "Cancelado"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Bitacora_cancelado": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
                      "table": "05d9b67a-a005-4826-ad13-67a622f834aa",
                      "item/Title": "Cancelado",
                      "item/Solicitud_ID_Num": "@triggerOutputs()?['body/ID']",
                      "item/Codigo": "@coalesce(triggerOutputs()?['body/Codigo'],'')",
                      "item/Evento": "Cancelado",
                      "item/Actor_Email": "@toLower(coalesce(triggerOutputs()?['body/Editor/Email'],''))",
                      "item/Detalle": "@concat('Cancelado desde ', triggerOutputs()?['body/Estado/Value'])",
                      "item/Fecha": "@utcNow()"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Pasar_a_cancelado": [
                      "Succeeded"
                    ]
                  }
                },
                "Estaba_en_bandeja": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@triggerOutputs()?['body/Estado/Value']",
                      "Pendiente de firma"
                    ]
                  },
                  "actions": {
                    "Correo_gerente": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "SendEmailV2"
                        },
                        "parameters": {
                          "emailMessage/To": "@{if(equals(parameters('ini_FIRMA_ModoPrueba (ini_FIRMA_ModoPrueba)'),'SI'), parameters('ini_FIRMA_CorreoSoporte (ini_FIRMA_CorreoSoporte)'), coalesce(first(body('Filtrar_Gerente'))?['Email'], parameters('ini_FIRMA_CorreoSoporte (ini_FIRMA_CorreoSoporte)')))}",
                          "emailMessage/Subject": "@{if(equals(parameters('ini_FIRMA_ModoPrueba (ini_FIRMA_ModoPrueba)'),'SI'),'[PRUEBA] ','')}Solicitud cancelada: @{triggerOutputs()?['body/Title']} (@{triggerOutputs()?['body/Codigo']})",
                          "emailMessage/Body": "<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#1f2937;max-width:640px\">\n<div style=\"background:#00539B;color:#fff;padding:14px 18px;font-size:16px;font-weight:600\">Solicitud cancelada</div>\n<div style=\"padding:16px 18px;border:1px solid #d6dde6;border-top:0\">\n<p style=\"margin:0 0 12px\">Esta solicitud se canceló y salió de su bandeja de firma.</p>\n<table style=\"border-collapse:collapse;width:100%\"><tr><td style=\"padding:6px 8px;background:#f3f6f9;width:170px;font-weight:600\">Código</td><td style=\"padding:6px 8px\">@{triggerOutputs()?['body/Codigo']}</td></tr><tr><td style=\"padding:6px 8px;background:#f3f6f9;width:170px;font-weight:600\">Título</td><td style=\"padding:6px 8px\">@{triggerOutputs()?['body/Title']}</td></tr><tr><td style=\"padding:6px 8px;background:#f3f6f9;width:170px;font-weight:600\">Solicitante</td><td style=\"padding:6px 8px\">@{coalesce(triggerOutputs()?['body/Solicitante_Nombre'], triggerOutputs()?['body/Solicitante/DisplayName'], triggerOutputs()?['body/Author/DisplayName'])}</td></tr><tr><td style=\"padding:6px 8px;background:#f3f6f9;width:170px;font-weight:600\">Cancelada por</td><td style=\"padding:6px 8px\">@{triggerOutputs()?['body/Editor/DisplayName']}</td></tr></table>\n\n<p style=\"margin:16px 0 0;color:#6b7280;font-size:12px\">Firma de Documentos · INI. Correo automático, no responder.</p>\n</div></div>",
                          "emailMessage/Importance": "Normal"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Bitacora_cancelado": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Devolver_estado": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "parameters": {
                        "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
                        "table": "767347d5-3d27-4b12-8360-f114d5c51002",
                        "id": "@triggerOutputs()?['body/ID']",
                        "item/Title": "@triggerOutputs()?['body/Title']",
                        "item/Accion": "Revisar",
                        "item/Error_Detalle": "@concat('Cancelación no autorizada para ', toLower(coalesce(triggerOutputs()?['body/Editor/Email'],'')))"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {}
                  },
                  "Bitacora_invalido": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PostItem"
                      },
                      "parameters": {
                        "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
                        "table": "05d9b67a-a005-4826-ad13-67a622f834aa",
                        "item/Title": "Cancelación no válida",
                        "item/Solicitud_ID_Num": "@triggerOutputs()?['body/ID']",
                        "item/Codigo": "@coalesce(triggerOutputs()?['body/Codigo'],'')",
                        "item/Evento": "Cancelación no válida",
                        "item/Actor_Email": "@toLower(coalesce(triggerOutputs()?['body/Editor/Email'],''))",
                        "item/Detalle": "@concat('No autorizado: ', toLower(coalesce(triggerOutputs()?['body/Editor/Email'],'')))",
                        "item/Fecha": "@utcNow()"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {
                      "Devolver_estado": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Es_autorizado": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Filtrar_Gerente": [
              "Succeeded"
            ]
          }
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Detalle_error": {
              "type": "Compose",
              "inputs": "@substring(string(result('Try')), 0, min(length(string(result('Try'))), 3500))",
              "runAfter": {}
            },
            "Marcar_error": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
                  "table": "767347d5-3d27-4b12-8360-f114d5c51002",
                  "id": "@triggerOutputs()?['body/ID']",
                  "item/Title": "@triggerOutputs()?['body/Title']",
                  "item/Accion": "Error",
                  "item/Error_Detalle": "@outputs('Detalle_error')"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Detalle_error": [
                  "Succeeded"
                ]
              }
            },
            "Bitacora_error": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem"
                },
                "parameters": {
                  "dataset": "@parameters('ini_FIRMA_SitioUrl (ini_FIRMA_SitioUrl)')",
                  "table": "05d9b67a-a005-4826-ad13-67a622f834aa",
                  "item/Title": "Error en F04 Cancelar",
                  "item/Solicitud_ID_Num": "@triggerOutputs()?['body/ID']",
                  "item/Codigo": "@coalesce(triggerOutputs()?['body/Codigo'],'')",
                  "item/Evento": "Error en F04 Cancelar",
                  "item/Actor_Email": "@toLower(coalesce(triggerOutputs()?['body/Editor/Email'],''))",
                  "item/Detalle": "@outputs('Detalle_error')",
                  "item/Fecha": "@utcNow()"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Marcar_error": [
                  "Succeeded"
                ]
              }
            },
            "Correo_soporte": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "@{parameters('ini_FIRMA_CorreoSoporte (ini_FIRMA_CorreoSoporte)')}",
                  "emailMessage/Subject": "[FIRMA] Error en F04 Cancelar · solicitud @{triggerOutputs()?['body/ID']}",
                  "emailMessage/Body": "<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#1f2937;max-width:640px\">\n<div style=\"background:#00539B;color:#fff;padding:14px 18px;font-size:16px;font-weight:600\">Error en F04 Cancelar</div>\n<div style=\"padding:16px 18px;border:1px solid #d6dde6;border-top:0\">\n<p style=\"margin:0 0 12px\">El flujo falló. Detalle técnico:</p>\n<table style=\"border-collapse:collapse;width:100%\"><tr><td style=\"padding:6px 8px;background:#f3f6f9;width:170px;font-weight:600\">Solicitud</td><td style=\"padding:6px 8px\">@{triggerOutputs()?['body/ID']} · @{triggerOutputs()?['body/Title']}</td></tr><tr><td style=\"padding:6px 8px;background:#f3f6f9;width:170px;font-weight:600\">Ejecución</td><td style=\"padding:6px 8px\">@{workflow()?['run']?['name']}</td></tr><tr><td style=\"padding:6px 8px;background:#f3f6f9;width:170px;font-weight:600\">Detalle</td><td style=\"padding:6px 8px\">@{outputs('Detalle_error')}</td></tr></table>\n\n<p style=\"margin:16px 0 0;color:#6b7280;font-size:12px\">Firma de Documentos · INI. Correo automático, no responder.</p>\n</div></div>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Bitacora_error": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}